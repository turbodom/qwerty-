# Сервер
PORT=2567
# Секрет для подписи игровых сессий (длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string
# Ключ Server API из Pi Developer Portal (никогда не коммитить настоящий ключ)
PI_API_KEY=
# Адрес Pi Platform API
PI_API_BASE=https://api.minepi.com
# Гостевой вход по имени, чтобы играть в обычном браузере без Pi (включён по умолчанию).
# Перед подачей в Pi Mainnet поставить false: Pi разрешает только вход через Pi.
ALLOW_GUEST_LOGIN=true
# Адрес клиента для CORS
CLIENT_ORIGIN=http://localhost:5173
# Сезонная Пустошь: длина игрового дня в минутах и сезона в днях
WORLD_DAY_MINUTES=1440
WORLD_SEASON_DAYS=28
# Где хранить мир между перезапусками: Upstash Redis (бесплатно, upstash.com) или файл. Без них мир живёт до перезапуска.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WORLD_FILE=

# Клиент (Vite)
VITE_SERVER_URL=http://localhost:2567
VITE_PI_SANDBOX=true
# Вход и оплата через Pi. Пока выключено: и в Pi Browser, и в обычном браузере работает гостевой вход.
VITE_PI_LOGIN=false
