# Сервер
PORT=2567
# Секрет для подписи игровых сессий (длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string
# Ключ Server API из Pi Developer Portal (никогда не коммитить настоящий ключ)
PI_API_KEY=
# Адрес Pi Platform API
PI_API_BASE=https://api.minepi.com
# Гостевой вход по имени, чтобы играть в обычном браузере без Pi (включён по умолчанию).
# Перед подачей в Pi Mainnet поставить false: Pi разрешает только вход через Pi.
ALLOW_GUEST_LOGIN=true
# Адрес клиента для CORS
CLIENT_ORIGIN=http://localhost:5173

# Клиент (Vite)
VITE_SERVER_URL=http://localhost:2567
VITE_PI_SANDBOX=true
